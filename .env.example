# Server only. Never prefix secrets with VITE_. Local rehearsal does not call AWS.
AI_PROVIDER=mock
# bedrock or ec2. ec2 uses a private S3 mailbox and the bounded Qwen worker.
LLM_BACKEND=bedrock
AWS_REGION=ap-south-1
AWS_PROFILE=parali
# Set a verified in-region Converse-compatible model ID. No silent region fallback.
BEDROCK_MODEL_ID=
POLLY_VOICE=Kajal
POLLY_ENGINE=neural
AUDIO_BUCKET=
SESSION_TABLE=
# Direct AWS Nova voice uses a separate rolling-hour connection allowance.
VOICE_BACKEND=transcribe
SONIC_REGION=ap-northeast-1
SONIC_MODEL_ID=amazon.nova-2-5-sonic
SONIC_ROLE_ARN=
SONIC_CONNECTIONS_PER_HOUR=60
# Server-only maintenance credential. Product pages open directly without a key.
PLATFORM_SETUP_KEY=
ALLOWED_ORIGIN=http://localhost:5173
# Frontend public API URL only; empty uses Vite proxy locally.
VITE_API_URL=
